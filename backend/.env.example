# FoodShare backend configuration.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------- server ----
PORT=3000
NODE_ENV=development
# Absolute base URL of this API. Used to build image URLs returned to the SPA.
PUBLIC_API_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# -------------------------------------------------------------- database ----
# The app uses its own `foodshare` schema, NOT `public`. Keycloak stores its
# tables in the same database, and `prisma db push` offers to delete any table
# it does not recognise. Keeping the app in a separate schema means it can never
# see, or destroy, Keycloak's tables. Create it once with:
#   docker exec foodshare-db psql -U foodshare -d foodshare_db -c "CREATE SCHEMA IF NOT EXISTS foodshare;"
DATABASE_URL=postgresql://foodshare:foodshare_password@localhost:5432/foodshare_db?schema=foodshare

# -------------------------------------------------------------- keycloak ----
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=foodshare
KEYCLOAK_CLIENT_ID=foodshare-web

# Server-side only. Used to assign the realm role chosen during onboarding.
# These match the docker-compose Keycloak admin account for local development.
# Member 1: replace with a dedicated service account before any deployment.
KEYCLOAK_ADMIN_SYNC=true
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Development escape hatch: accept bearer tokens without verifying their
# signature, so the API can run with no Keycloak container. Automatically
# ignored when NODE_ENV=production. Leave false unless you know why you need it.
AUTH_DEV_BYPASS=false

# -------------------------------------------------------------- rabbitmq ----
RABBITMQ_URL=amqp://user:password@localhost:5672
RABBITMQ_ENABLED=true
NOTIFICATION_QUEUE=notification_queue

# --------------------------------------------------------------- uploads ----
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# ------------------------------------------------------------- geocoding ----
# none | nominatim | google
#   none      - skip lookups, store no coordinates (default)
#   nominatim - free OpenStreetMap endpoint, no key needed, rate limited
#   google    - Google Maps Geocoding API, requires GOOGLE_MAPS_API_KEY
GEOCODING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
GEOCODING_TIMEOUT_MS=4000

# ---------------------------------------------------------------- policy ----
# FR2 reading: when true, new donor accounts also wait for admin approval
# before they may post. Default false matches the frontend's mock behaviour.
REQUIRE_DONOR_APPROVAL=false

# ------------------------------------------------------------ pagination ----
DEFAULT_PAGE_SIZE=6
MAX_PAGE_SIZE=50